# Copy to .env and fill in. .env is gitignored.
# This file grows as the pipeline does; nothing here is needed for week 1.

# Where the source PDFs live (see data/README.md)
DALEEL_RAW_DIR=data/raw

# Google AI Studio key for the answering arms (aistudio.google.com/apikey).
# The free tier is enough for evaluation runs; see the README.
GEMINI_API_KEY=

# The pilot's access code (README, Quickstart). Docker reads it from here, and
# daleel serve from the environment: set, only requests that send it are
# answered, and compose.pilot.yaml will not start without it. Make one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(12))'
# Leave it empty for Daleel on this machine alone.
DALEEL_ACCESS_CODE=
