# The image gets the code and nothing else. The data is derived from documents
# that are not redistributable, and .env holds the API key: neither may reach
# an image, or even the build context.
data
.env
.env.*
!.env.example

# Not needed to build or run the service.
.git
.github
.venv
venv
eval
scripts
tests
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info
build
dist
